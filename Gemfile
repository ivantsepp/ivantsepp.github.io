source 'https://rubygems.org'
# A simple, blog aware, static site generator. (https://github.com/jekyll/jekyll)
gem 'jekyll', '~> 4.4'
# Rake is a Make-like program implemented in Ruby (https://github.com/ruby/rake)
gem 'rake', '~> 13.0'
# Nokogiri (鋸) is an HTML, XML, SAX, and Reader parser (http://nokogiri.org)
gem 'nokogiri', '~> 1.18'
# GitHub Flavored Markdown parser for kramdown (https://github.com/kramdown/parser-gfm)
gem 'kramdown-parser-gfm'
# Emoji support, e.g. :+1: (https://github.com/jekyll/jemoji)
gem 'jemoji'
# @mention linking (https://github.com/jekyll/jekyll-mentions)
gem 'jekyll-mentions'
# Seamlessly specify multiple redirection URLs for your pages and posts (https://github.com/jekyll/jekyll-redirect-from)
gem 'jekyll-redirect-from'
# Automatically generate a sitemap.xml for your Jekyll site. (https://github.com/jekyll/jekyll-sitemap)
gem 'jekyll-sitemap'
# A set of tests to validate your HTML output. (https://github.com/gjtorikian/html-proofer)
gem 'html-proofer', '~> 5.0'
# Syntax highlighter used by Jekyll (https://github.com/rouge-ruby/rouge)
gem 'rouge'
# Needed for `jekyll serve` on Ruby 3+
gem 'webrick'
# No longer default gems as of newer Rubies; required by Jekyll
gem 'csv'
gem 'base64'
gem 'bigdecimal'
gem 'logger'
